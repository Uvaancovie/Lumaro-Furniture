<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route contact API requests to contact.php
  RewriteRule ^api/contact/?$ /api/contact.php [L,QSA]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
